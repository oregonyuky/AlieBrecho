@page
@{
    ViewData["Title"] = "Cliente";
}

<style>
    .page-summary-card {
        border: 1px solid #e9ecef;
        border-radius: 8px;
        padding: 12px 14px;
        background: #fff;
        height: 100%;
    }

    .page-summary-card .label {
        font-size: 0.8rem;
        color: #6c757d;
        margin-bottom: 4px;
    }

    .page-summary-card .value {
        font-size: 1.4rem;
        font-weight: 700;
        line-height: 1;
    }
</style>

<div id="app" v-cloak>
    <div class="row mb-3">
        <div class="col-12 col-md-4 mb-2">
            <div class="page-summary-card">
                <div class="label">Total de Clientes</div>
                <div class="value">{{ state.summary.total }}</div>
            </div>
        </div>
        <div class="col-12 col-md-4 mb-2">
            <div class="page-summary-card">
                <div class="label">Ativos</div>
                <div class="value">{{ state.summary.active }}</div>
            </div>
        </div>
        <div class="col-12 col-md-4 mb-2">
            <div class="page-summary-card">
                <div class="label">Inativos</div>
                <div class="value">{{ state.summary.inactive }}</div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="grid-container">
                <div ref="mainGridRef"></div>
            </div>
        </div>
    </div>

    <div class="modal fade" ref="mainModalRef" id="MainModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">{{ state.mainTitle }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" v-model="state.id" />

                    <form id="MainForm">
                        <div class="row mb-2">
                            <div class="col-md-6">
                                <label>Nome</label>
                                <input v-model="state.name" type="text" class="form-control" :disabled="state.deleteMode">
                                <label class="text-danger">{{ state.errors.name }}</label>
                            </div>
                            <div class="col-md-6">
                                <label>Status</label>
                                <select v-model="state.customerStatus" class="form-control" :disabled="state.deleteMode">
                                    <option value="Active">Ativo</option>
                                    <option value="Inactive">Inativo</option>
                                </select>
                            </div>
                        </div>

                        <div class="row mb-2">
                            <div class="col-md-6">
                                <label>CPF</label>
                                <input v-model="state.cpf" type="text" class="form-control" :disabled="state.deleteMode">
                            </div>
                            <div class="col-md-6">
                                <label>Telefone</label>
                                <input v-model="state.phoneNumber" type="text" class="form-control" :disabled="state.deleteMode">
                            </div>
                        </div>

                        <div class="row mb-2">
                            <div class="col-md-6">
                                <label>Email</label>
                                <input v-model="state.emailAddress" type="email" class="form-control" :disabled="state.deleteMode">
                            </div>
                            <div class="col-md-6">
                                <label>Website</label>
                                <input v-model="state.website" type="text" class="form-control" :disabled="state.deleteMode">
                            </div>
                        </div>

                        <div class="row mb-2">
                            <div class="col-12">
                                <label>Descricao</label>
                                <textarea v-model="state.description" class="form-control" rows="2" :disabled="state.deleteMode"></textarea>
                            </div>
                        </div>

                        <div class="row mb-2">
                            <div class="col-md-6">
                                <label>Rua</label>
                                <input v-model="state.street" type="text" class="form-control" :disabled="state.deleteMode">
                            </div>
                            <div class="col-md-2">
                                <label>Numero</label>
                                <input v-model="state.number" type="text" class="form-control" :disabled="state.deleteMode">
                            </div>
                            <div class="col-md-4">
                                <label>Bairro</label>
                                <input v-model="state.neighborhood" type="text" class="form-control" :disabled="state.deleteMode">
                            </div>
                        </div>

                        <div class="row mb-2">
                            <div class="col-md-4">
                                <label>Complemento</label>
                                <input v-model="state.complement" type="text" class="form-control" :disabled="state.deleteMode">
                            </div>
                            <div class="col-md-3">
                                <label>Cidade</label>
                                <input v-model="state.city" type="text" class="form-control" :disabled="state.deleteMode">
                            </div>
                            <div class="col-md-2">
                                <label>Estado</label>
                                <input v-model="state.stateRegion" type="text" class="form-control" :disabled="state.deleteMode">
                            </div>
                            <div class="col-md-3">
                                <label>CEP</label>
                                <input v-model="state.postalCode" type="text" class="form-control" :disabled="state.deleteMode">
                            </div>
                        </div>

                        <div class="row mb-2">
                            <div class="col-md-4">
                                <label>Pais</label>
                                <input v-model="state.country" type="text" class="form-control" :disabled="state.deleteMode">
                            </div>
                            <div class="col-md-4">
                                <label>Instagram</label>
                                <input v-model="state.instagram" type="text" class="form-control" :disabled="state.deleteMode">
                            </div>
                            <div class="col-md-4">
                                <label>Twitter/X</label>
                                <input v-model="state.twitterX" type="text" class="form-control" :disabled="state.deleteMode">
                            </div>
                        </div>

                        <div class="row mb-2">
                            <div class="col-md-4">
                                <label>TikTok</label>
                                <input v-model="state.tikTok" type="text" class="form-control" :disabled="state.deleteMode">
                            </div>
                        </div>
                    </form>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Fechar
                    </button>

                    <button type="button"
                            id="MainSaveButton"
                            class="btn"
                            :class="state.deleteMode ? 'btn-danger' : 'btn-primary'"
                            v-on:click="handler.handleSubmit"
                            :disabled="state.isSubmitting">

                        <span class="spinner-border spinner-border-sm me-2" v-if="state.isSubmitting"></span>

                        <span v-if="!state.isSubmitting">
                            {{ state.deleteMode ? 'Excluir' : 'Salvar' }}
                        </span>

                        <span v-else>
                            {{ state.deleteMode ? 'Excluindo...' : 'Salvando...' }}
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/FrontEnd/Pages/Customers/Customer.cshtml.js"></script>
}
