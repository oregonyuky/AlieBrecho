@{
    var companyName = "companyName";
    var companyWeb = "companyWeb";
    var year = DateTime.Now.Year;
    var configuredFrontLink = Environment.GetEnvironmentVariable("LINK_FRONT");
    var frontLink = string.IsNullOrWhiteSpace(configuredFrontLink)
        ? "https://store.aliebrecho.com"
        : configuredFrontLink.Trim();
}
<footer class="main-footer">
    <div class="float-right d-none d-sm-block">
        <b>Desenvolvido Por:</b>
        <a href="@frontLink" target="_blank" rel="noopener noreferrer">@frontLink</a>
    </div>
    <small id="footerContent">
        &copy; @year <a href="@companyWeb">@companyName</a>, Todos os direitos reservados.
    </small>
</footer>

