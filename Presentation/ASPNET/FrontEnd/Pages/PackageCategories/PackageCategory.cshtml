@page
@{
    ViewData["Title"] = "Categorias de Embalagem";
}

<div id="app" class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Categorias de Embalagem</h1>
            <p class="text-muted mb-0">Organize as embalagens pela capacidade em pontos.</p>
        </div>
        <button class="btn btn-primary" v-on:click="openNew"><i class="fas fa-plus me-2"></i>Nova Categoria</button>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light"><tr><th>Nome</th><th>Capacidade</th><th>Status</th><th class="text-end">Ações</th></tr></thead>
                    <tbody>
                        <tr v-for="item in items" v-bind:key="item.id">
                            <td><strong>{{ item.name }}</strong><small v-if="item.description" class="d-block text-muted">{{ item.description }}</small></td>
                            <td>{{ item.capacityPoints }} {{ item.capacityPoints === 1 ? 'ponto' : 'pontos' }}</td>
                            <td><span class="badge" v-bind:class="item.isActive ? 'bg-success' : 'bg-secondary'">{{ item.isActive ? 'Ativa' : 'Inativa' }}</span></td>
                            <td class="text-end"><button class="btn btn-sm btn-outline-primary me-2" v-on:click="openEdit(item)">Editar</button><button v-if="item.isActive" class="btn btn-sm btn-outline-danger" v-on:click="deactivate(item)">Desativar</button></td>
                        </tr>
                        <tr v-if="items.length === 0"><td colspan="4" class="text-center text-muted py-4">Nenhuma categoria cadastrada.</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="modal fade" ref="modalRef" tabindex="-1" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">{{ form.id ? 'Editar Categoria' : 'Nova Categoria' }}</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <label class="form-label">Nome</label><input class="form-control mb-3" v-model.trim="form.name" maxlength="150" required>
                <label class="form-label">Capacidade</label><div class="input-group mb-3"><input class="form-control" type="number" min="1" step="1" v-model.number="form.capacityPoints"><span class="input-group-text">pontos</span></div>
                <label class="form-label">Descrição</label><textarea class="form-control mb-3" rows="3" maxlength="500" v-model.trim="form.description"></textarea>
                <div class="form-check"><input id="packageCategoryActive" class="form-check-input" type="checkbox" v-model="form.isActive"><label for="packageCategoryActive" class="form-check-label">Ativa</label></div>
            </div>
            <div class="modal-footer"><button class="btn btn-light" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-primary" v-on:click="save" v-bind:disabled="submitting">Salvar</button></div>
        </div></div>
    </div>
</div>

@section scripts {
    <script src="~/FrontEnd/Pages/PackageCategories/PackageCategory.cshtml.js?v=20260722"></script>
}
