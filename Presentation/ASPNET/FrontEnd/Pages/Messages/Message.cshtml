@page
@{
    ViewData["Title"] = "Mensagens";
}

<style>
    .message-admin {
        background: #f4f6f9;
        color: #27313c;
        min-height: calc(100vh - 120px);
        padding: 18px;
    }

    .message-admin [v-cloak] {
        display: none;
    }

    .message-header {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        justify-content: space-between;
        margin-bottom: 18px;
    }

    .message-title {
        align-items: center;
        display: flex;
        font-size: 25px;
        font-weight: 700;
        gap: 10px;
        margin: 0;
    }

    .message-title i {
        color: #52606d;
    }

    .message-unread-count {
        align-items: center;
        background: #fee2e2;
        border-radius: 999px;
        color: #b91c1c;
        display: inline-flex;
        font-size: 13px;
        font-weight: 800;
        gap: 6px;
        padding: 5px 10px;
    }

    .message-unread-dot {
        background: #dc2626;
        border-radius: 50%;
        display: inline-block;
        height: 9px;
        width: 9px;
    }

    .message-toolbar {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        justify-content: space-between;
        margin-bottom: 14px;
    }

    .message-search {
        background: #fff;
        border: 1px solid #d5dce3;
        border-radius: 7px;
        font-size: 13px;
        max-width: 360px;
        outline: none;
        padding: 10px 13px;
        width: 100%;
    }

    .message-search:focus {
        border-color: #657382;
        box-shadow: 0 0 0 3px rgba(82, 96, 109, 0.1);
    }

    .message-filters {
        display: flex;
        gap: 8px;
    }

    .message-filter,
    .message-action {
        background: #fff;
        border: 1px solid #d5dce3;
        border-radius: 6px;
        color: #33404d;
        cursor: pointer;
        font-size: 12px;
        font-weight: 700;
        padding: 8px 12px;
    }

    .message-filter--active,
    .message-action:hover {
        background: #222831;
        border-color: #222831;
        color: #fff;
    }

    .message-table-card {
        background: #fff;
        border: 1px solid #dde3ea;
        border-radius: 8px;
        box-shadow: 0 8px 22px rgba(31, 41, 51, 0.06);
        overflow: hidden;
    }

    .message-table-scroll {
        overflow-x: auto;
    }

    .message-table {
        border-collapse: collapse;
        min-width: 850px;
        width: 100%;
    }

    .message-table th {
        background: #f8fafc;
        border-bottom: 1px solid #dce3e9;
        color: #5b6773;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: .03em;
        padding: 13px 15px;
        text-align: left;
        text-transform: uppercase;
    }

    .message-table td {
        border-bottom: 1px solid #edf0f3;
        font-size: 13px;
        padding: 14px 15px;
        vertical-align: middle;
    }

    .message-row--unread {
        background: #fffafa;
        font-weight: 700;
    }

    .message-status {
        align-items: center;
        display: inline-flex;
        gap: 7px;
        white-space: nowrap;
    }

    .message-status--read {
        color: #78838e;
        font-weight: 500;
    }

    .message-email {
        color: #4f6070;
    }

    .message-subject {
        display: block;
        max-width: 310px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .message-empty {
        color: #78838e;
        padding: 30px !important;
        text-align: center;
    }

    .message-modal-overlay {
        align-items: center;
        background: rgba(17, 24, 39, .62);
        bottom: 0;
        display: flex;
        justify-content: center;
        left: 0;
        padding: 18px;
        position: fixed;
        right: 0;
        top: 0;
        z-index: 1100;
    }

    .message-modal {
        background: #fff;
        border-radius: 9px;
        box-shadow: 0 22px 65px rgba(0, 0, 0, .24);
        max-height: calc(100vh - 36px);
        overflow-y: auto;
        padding: 25px;
        position: relative;
        width: min(720px, 100%);
    }

    .message-modal__close {
        align-items: center;
        background: #fff;
        border: 1px solid #d5dce3;
        border-radius: 6px;
        cursor: pointer;
        display: inline-flex;
        height: 34px;
        justify-content: center;
        position: absolute;
        right: 18px;
        top: 18px;
        width: 34px;
    }

    .message-modal h2 {
        font-size: 20px;
        margin: 0 45px 20px 0;
    }

    .message-detail-grid {
        display: grid;
        gap: 14px;
        grid-template-columns: 1fr 1fr;
        margin-bottom: 20px;
    }

    .message-detail-grid div {
        background: #f8fafc;
        border-radius: 6px;
        padding: 11px 13px;
    }

    .message-detail-grid small,
    .message-body-label {
        color: #7a8692;
        display: block;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: .05em;
        margin-bottom: 4px;
        text-transform: uppercase;
    }

    .message-detail-grid strong {
        font-size: 13px;
        overflow-wrap: anywhere;
    }

    .message-body {
        background: #f8fafc;
        border-left: 3px solid #d79ba1;
        line-height: 1.7;
        min-height: 120px;
        padding: 16px;
        white-space: pre-wrap;
    }

    @@media (max-width: 640px) {
        .message-admin {
            padding: 12px;
        }

        .message-toolbar {
            align-items: stretch;
            flex-direction: column;
        }

        .message-search {
            max-width: none;
        }

        .message-detail-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div id="app" class="message-admin" v-cloak>
    <header class="message-header">
        <h1 class="message-title">
            <i class="fas fa-comments" aria-hidden="true"></i>
            Mensagens
            <span class="message-unread-count" v-if="state.unreadCount > 0">
                <span class="message-unread-dot"></span>
                {{ state.unreadCount }}
            </span>
        </h1>
    </header>

    <div class="message-toolbar">
        <input class="message-search" v-model="state.search" type="search" placeholder="Buscar por nome, e-mail ou assunto...">
        <div class="message-filters">
            <button class="message-filter" v-bind:class="{ 'message-filter--active': state.filter === 'all' }" type="button" v-on:click="state.filter = 'all'">Todas</button>
            <button class="message-filter" v-bind:class="{ 'message-filter--active': state.filter === 'unread' }" type="button" v-on:click="state.filter = 'unread'">Não lidas</button>
            <button class="message-filter" type="button" title="Atualizar" v-on:click="handler.refresh"><i class="fas fa-sync-alt"></i></button>
        </div>
    </div>

    <section class="message-table-card">
        <div class="message-table-scroll">
            <table class="message-table">
                <thead>
                    <tr>
                        <th>Status</th>
                        <th>Nome</th>
                        <th>E-mail</th>
                        <th>Assunto</th>
                        <th>Recebido em</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    <tr v-for="message in filteredMessages" v-bind:key="message.id" v-bind:class="{ 'message-row--unread': !message.isRead }">
                        <td>
                            <span class="message-status" v-bind:class="{ 'message-status--read': message.isRead }">
                                <span class="message-unread-dot" v-if="!message.isRead"></span>
                                {{ message.isRead ? 'Lida' : 'Não lida' }}
                            </span>
                        </td>
                        <td>{{ message.name }}</td>
                        <td class="message-email">{{ message.email }}</td>
                        <td><span class="message-subject" v-bind:title="message.subject">{{ message.subject }}</span></td>
                        <td>{{ methods.formatReceivedAt(message.receivedAtUtc) }}</td>
                        <td><button class="message-action" type="button" v-on:click="handler.view(message)">Visualizar</button></td>
                    </tr>
                    <tr v-if="filteredMessages.length === 0">
                        <td class="message-empty" colspan="6">Nenhuma mensagem encontrada.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    <div class="message-modal-overlay" v-if="state.selected" v-on:click.self="handler.close">
        <article class="message-modal" role="dialog" aria-modal="true" aria-labelledby="messageModalTitle">
            <button class="message-modal__close" type="button" aria-label="Fechar" v-on:click="handler.close"><i class="fas fa-times"></i></button>
            <h2 id="messageModalTitle">{{ state.selected.subject }}</h2>
            <div class="message-detail-grid">
                <div><small>Nome</small><strong>{{ state.selected.name }}</strong></div>
                <div><small>E-mail</small><strong>{{ state.selected.email }}</strong></div>
                <div><small>Telefone</small><strong>{{ state.selected.phone }}</strong></div>
                <div><small>Recebido em</small><strong>{{ methods.formatFullDate(state.selected.receivedAtUtc) }}</strong></div>
            </div>
            <span class="message-body-label">Mensagem</span>
            <div class="message-body">{{ state.selected.message }}</div>
        </article>
    </div>
</div>

@section scripts {
    <script src="~/FrontEnd/Pages/Messages/Message.cshtml.js" asp-append-version="true"></script>
}
