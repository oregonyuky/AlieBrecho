@page
@{
    ViewData["Title"] = "Pedidos";
}

<style>
    .page-summary-card {
        border: 1px solid var(--summary-border, #e9ecef);
        border-radius: 8px;
        padding: 12px 14px;
        background: var(--summary-bg, #fff);
        color: var(--summary-text, #111827);
        height: 100%;
        box-shadow: 0 10px 24px rgba(15, 23, 42, 0.06);
    }

    .page-summary-card .label {
        font-size: 0.8rem;
        color: var(--summary-muted, #6c757d);
        margin-bottom: 4px;
    }

    .page-summary-card .value {
        font-size: 1.4rem;
        font-weight: 700;
        line-height: 1;
    }

    .summary-total {
        --summary-bg: linear-gradient(135deg, #f8fafc 0%, #eef2ff 100%);
        --summary-border: #dbe4ff;
        --summary-muted: #64748b;
        --summary-text: #1e293b;
    }

    .summary-pending {
        --summary-bg: linear-gradient(135deg, #fff7ed 0%, #fef3c7 100%);
        --summary-border: #fed7aa;
        --summary-muted: #9a3412;
        --summary-text: #7c2d12;
    }

    .summary-paid {
        --summary-bg: linear-gradient(135deg, #ecfdf5 0%, #ccfbf1 100%);
        --summary-border: #99f6e4;
        --summary-muted: #047857;
        --summary-text: #064e3b;
    }

    .summary-cancelled {
        --summary-bg: linear-gradient(135deg, #fff1f2 0%, #ffe4e6 100%);
        --summary-border: #fecdd3;
        --summary-muted: #be123c;
        --summary-text: #881337;
    }

    .summary-balance {
        --summary-bg: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
        --summary-border: #bae6fd;
        --summary-muted: #0369a1;
        --summary-text: #0c4a6e;
    }

    .summary-reserved {
        --summary-bg: linear-gradient(135deg, #f5f3ff 0%, #ede9fe 100%);
        --summary-border: #ddd6fe;
        --summary-muted: #6d28d9;
        --summary-text: #4c1d95;
    }

    .summary-debts {
        --summary-bg: linear-gradient(135deg, #fdf2f8 0%, #fae8ff 100%);
        --summary-border: #f5d0fe;
        --summary-muted: #a21caf;
        --summary-text: #701a75;
    }
</style>

<div id="app" v-cloak>
    <div class="row mb-3">
        <div class="col-12 col-md-6 col-xl-3 mb-2">
            <div class="page-summary-card summary-total">
                <div class="label">Total de Pedidos</div>
                <div class="value">{{ state.summary.total }}</div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xl-3 mb-2">
            <div class="page-summary-card summary-pending">
                <div class="label">Pendentes</div>
                <div class="value">{{ state.summary.pending }}</div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xl-3 mb-2">
            <div class="page-summary-card summary-paid">
                <div class="label">Pagos</div>
                <div class="value">{{ state.summary.paid }}</div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xl-3 mb-2">
            <div class="page-summary-card summary-cancelled">
                <div class="label">Cancelados</div>
                <div class="value">{{ state.summary.cancelled }}</div>
            </div>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-12 col-md-4 mb-2">
            <div class="page-summary-card summary-balance">
                <div class="label">Saldo Melhor Envio</div>
                <div class="value">
                    <span v-if="state.melhorEnvioBalance.isLoading">Carregando...</span>
                    <span v-else>{{ formatCurrency(state.melhorEnvioBalance.balance) }}</span>
                </div>
                <button type="button" class="btn btn-sm btn-primary mt-2" v-on:click="methods.openInsertBalance" v-bind:disabled="state.melhorEnvioBalance.isInserting">
                    <span class="spinner-border spinner-border-sm me-1" v-if="state.melhorEnvioBalance.isInserting"></span>
                    <i class="fa fa-wallet" v-if="!state.melhorEnvioBalance.isInserting"></i>
                    Inserir saldo
                </button>
                <small class="text-danger" v-if="state.melhorEnvioBalance.error">{{ state.melhorEnvioBalance.error }}</small>
            </div>
        </div>
        <div class="col-12 col-md-4 mb-2">
            <div class="page-summary-card summary-reserved">
                <div class="label">Reservado</div>
                <div class="value">{{ formatCurrency(state.melhorEnvioBalance.reserved) }}</div>
            </div>
        </div>
        <div class="col-12 col-md-4 mb-2">
            <div class="page-summary-card summary-debts">
                <div class="label">Debitos</div>
                <div class="value">{{ formatCurrency(state.melhorEnvioBalance.debts) }}</div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="grid-container">
                <div ref="mainGridRef"></div>
            </div>
        </div>
    </div>

    <div class="modal fade" ref="mainModalRef" id="MainModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-scrollable modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">{{ state.mainTitle }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" v-model="state.id" />

                    <div class="alert alert-danger" v-if="state.deleteMode">
                        Confirme a exclusao deste pedido.
                    </div>

                    <div class="row mb-3">
                        <div class="col-4">
                            <label>Cliente</label>
                            <select class="form-select" v-model="state.customerId" v-on:change="methods.handleCustomerChange" v-bind:disabled="state.deleteMode">
                                <option value="">Selecione</option>
                                <option v-for="item in state.customers" :value="item.id">{{ item.name }}</option>
                            </select>
                            <small class="text-danger" v-if="state.errors.customerId">{{ state.errors.customerId }}</small>
                        </div>
                        <div class="col-4">
                            <label>Status</label>
                            <select class="form-select" v-model="state.status" v-bind:disabled="state.deleteMode">
                                <option v-for="item in state.orderStatuses" :value="item">{{ translateStatus(item) }}</option>
                            </select>
                        </div>
                        <div class="col-4">
                            <label>Data do Pedido</label>
                            <input type="text" class="form-control" :value="formatDate(state.orderDate)" disabled />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-3">
                            <label>Desconto</label>
                            <input type="number" class="form-control" v-model.number="state.discount" v-on:input="handler.recalculateTotal" v-bind:disabled="state.deleteMode" />
                        </div>
                        <div class="col-3">
                            <label>Taxas</label>
                            <input type="number" class="form-control" v-model.number="state.taxes" v-on:input="handler.recalculateTotal" v-bind:disabled="state.deleteMode" />
                        </div>
                        <div class="col-3">
                            <label>Frete</label>
                            <input type="number" class="form-control" v-model.number="state.shippingCost" disabled />
                        </div>
                        <div class="col-3">
                            <label>Valor Total</label>
                            <input type="number" class="form-control" v-model.number="state.totalAmount" disabled />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-4">
                            <label>Caixa de Envio</label>
                            <div class="input-group">
                                <select class="form-select" v-model="state.shippingBoxId" v-on:change="methods.handleShippingBoxChange" v-bind:disabled="state.deleteMode">
                                    <option value="">Selecione</option>
                                    <option v-for="item in state.shippingBoxes" :value="item.id">
                                        {{ formatShippingBoxData(item) }}
                                    </option>
                                </select>
                                <button type="button" class="btn btn-outline-secondary" v-on:click="methods.showShippingBoxInfo" v-bind:disabled="!state.shippingBoxId">
                                    <i class="fa fa-info-circle"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-8">
                            <label>Notas</label>
                            <textarea class="form-control" v-model="state.notes" rows="1" v-bind:disabled="state.deleteMode"></textarea>
                        </div>
                    </div>

                    <div class="row mb-3" v-if="state.shippingBoxId">
                        <div class="col-12">
                            <div class="border rounded p-3 bg-light">
                                <div class="row g-3">
                                    <div class="col-2">
                                        <small class="text-muted d-block">Largura</small>
                                        <strong>{{ formatNumber(getSelectedShippingBox()?.width) }} cm</strong>
                                    </div>
                                    <div class="col-2">
                                        <small class="text-muted d-block">Comprimento</small>
                                        <strong>{{ formatNumber(getSelectedShippingBox()?.length) }} cm</strong>
                                    </div>
                                    <div class="col-2">
                                        <small class="text-muted d-block">Altura</small>
                                        <strong>{{ formatNumber(getSelectedShippingBox()?.height) }} cm</strong>
                                    </div>
                                    <div class="col-2">
                                        <small class="text-muted d-block">Peso</small>
                                        <strong>{{ formatNumber(getSelectedShippingBox()?.weight) }} kg</strong>
                                    </div>
                                    <div class="col-2">
                                        <small class="text-muted d-block">Peso Cobrado</small>
                                        <strong>{{ formatNumber(calculateChargedWeight(getSelectedShippingBox())) }} kg</strong>
                                    </div>
                                    <div class="col-2">
                                        <small class="text-muted d-block">Frete</small>
                                        <strong>{{ formatCurrency(state.shippingCost) }}</strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <h5 class="mt-4">Itens do Pedido</h5>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead>
                                <tr>
                                    <th>Produto</th>
                                    <th style="width: 120px;">Qtd</th>
                                    <th style="width: 160px;">Preco Unitario</th>
                                    <th style="width: 140px;">Total do Produto</th>
                                    <th style="width: 140px;">Frete do Produto</th>
                                    <th style="width: 70px;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr v-for="(item, index) in state.orderDetails" :key="index">
                                    <td>
                                        <select class="form-select" v-model="item.productId" v-on:change="methods.handleProductChange(item)" v-bind:disabled="state.deleteMode">
                                            <option value="">Selecione</option>
                                            <option v-for="product in state.products" :value="product.id">{{ product.name }}</option>
                                        </select>
                                    </td>
                                    <td>
                                        <input type="number" min="1" class="form-control" v-model.number="item.quantity" v-on:input="handler.recalculateTotal" v-bind:disabled="state.deleteMode" />
                                    </td>
                                    <td>
                                        <input type="number" class="form-control" v-model.number="item.unitPrice" v-on:input="handler.recalculateTotal" v-bind:disabled="state.deleteMode" />
                                    </td>
                                    <td>{{ formatCurrency(getItemTotal(item)) }}</td>
                                    <td>{{ formatCurrency(getItemShippingCost(item)) }}</td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-sm btn-outline-danger" v-on:click="methods.removeOrderItem(index)" v-bind:disabled="state.deleteMode">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                                <tr v-if="!state.orderDetails.length">
                                    <td colspan="6" class="text-muted text-center">Nenhum item adicionado.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <small class="text-danger" v-if="state.errors.orderDetails">{{ state.errors.orderDetails }}</small>
                        <button type="button" class="btn btn-sm btn-outline-primary ms-auto" v-on:click="methods.addOrderItem" v-bind:disabled="state.deleteMode">
                            <i class="fa fa-plus"></i> Adicionar Item
                        </button>
                    </div>

                    <h5 class="mt-4">Detalhes do Pagamento</h5>
                    <div class="row mb-3">
                        <div class="col-4">
                            <label>Status do Pagamento</label>
                            <select class="form-select" v-model="state.payment.status" v-bind:disabled="state.deleteMode">
                                <option v-for="item in state.paymentStatuses" :value="item">{{ translateStatus(item) }}</option>
                            </select>
                        </div>
                        <div class="col-4">
                            <label>Forma de Pagamento</label>
                            <select class="form-select" v-model="state.payment.paymentTypeId" v-bind:disabled="state.deleteMode">
                                <option value="">Selecione</option>
                                <option v-for="item in state.paymentTypes" :value="item.id">{{ item.typeName }}</option>
                            </select>
                        </div>
                        <div class="col-4">
                            <label>Valor</label>
                            <input type="number" class="form-control" v-model.number="state.payment.amount" v-bind:disabled="state.deleteMode" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-4">
                            <label>Data do Pagamento</label>
                            <input type="datetime-local" class="form-control" v-model="state.payment.paymentDateTime" v-bind:disabled="state.deleteMode" />
                        </div>
                        <div class="col-4">
                            <label>ID da Transacao</label>
                            <input type="text" class="form-control" v-model="state.payment.transactionId" v-bind:disabled="state.deleteMode" />
                        </div>
                        <div class="col-4">
                            <label>Codigo de Autorizacao</label>
                            <input type="text" class="form-control" v-model="state.payment.authorizationCode" v-bind:disabled="state.deleteMode" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-4">
                            <label>Metodo de Pagamento</label>
                            <input type="text" class="form-control" v-model="state.payment.paymentMethod" v-bind:disabled="state.deleteMode" />
                        </div>
                        <div class="col-4">
                            <label>Nome no Cartao</label>
                            <input type="text" class="form-control" v-model="state.payment.cardHolderName" v-bind:disabled="state.deleteMode" />
                        </div>
                        <div class="col-4">
                            <label>Ultimos 4 Digitos</label>
                            <input type="text" class="form-control" v-model="state.payment.cardLast4" v-bind:disabled="state.deleteMode" />
                        </div>
                    </div>

                    <h5 class="mt-4">Detalhes do Envio</h5>
                    <div class="row mb-3">
                        <div class="col-3">
                            <label>Nome</label>
                            <input type="text" class="form-control" v-model="state.shipping.firstName" v-bind:disabled="state.deleteMode" />
                        </div>
                        <div class="col-3">
                            <label>Sobrenome</label>
                            <input type="text" class="form-control" v-model="state.shipping.lastName" v-bind:disabled="state.deleteMode" />
                        </div>
                        <div class="col-3">
                            <label>Email</label>
                            <input type="email" class="form-control" v-model="state.shipping.email" v-bind:disabled="state.deleteMode" />
                        </div>
                        <div class="col-3">
                            <label>Telefone</label>
                            <input type="text" class="form-control" v-model="state.shipping.phoneNumber" v-bind:disabled="state.deleteMode" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-4">
                            <label>Rua</label>
                            <input type="text" class="form-control" v-model="state.shipping.street" v-bind:disabled="state.deleteMode" />
                        </div>
                        <div class="col-2">
                            <label>Numero</label>
                            <input type="text" class="form-control" v-model="state.shipping.number" v-bind:disabled="state.deleteMode" />
                        </div>
                        <div class="col-3">
                            <label>Bairro</label>
                            <input type="text" class="form-control" v-model="state.shipping.neighborhood" v-bind:disabled="state.deleteMode" />
                        </div>
                        <div class="col-3">
                            <label>Complemento</label>
                            <input type="text" class="form-control" v-model="state.shipping.complement" v-bind:disabled="state.deleteMode" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-3">
                            <label>Cidade</label>
                            <input type="text" class="form-control" v-model="state.shipping.city" v-bind:disabled="state.deleteMode" />
                        </div>
                        <div class="col-3">
                            <label>Estado</label>
                            <input type="text" class="form-control" v-model="state.shipping.state" v-bind:disabled="state.deleteMode" />
                        </div>
                        <div class="col-3">
                            <label>CEP</label>
                            <input type="text" class="form-control" v-model="state.shipping.postCode" v-on:blur="methods.refreshShippingCost" v-bind:disabled="state.deleteMode" />
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                    <button type="button" id="MainSaveButton" v-bind:class="state.deleteMode ? 'btn btn-danger' : 'btn btn-primary'" v-on:click="handler.handleSubmit" v-bind:disabled="state.isSubmitting">
                        <span class="spinner-border spinner-border-sm me-2" v-if="state.isSubmitting"></span>
                        <span v-if="!state.isSubmitting">{{ state.deleteMode ? 'Excluir' : 'Salvar' }}</span>
                        <span v-else>{{ state.deleteMode ? 'Excluindo...' : 'Salvando...' }}</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" ref="labelModalRef" id="ShippingLabelModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-scrollable modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Carrinho Melhor Envio</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <div class="alert alert-danger" v-if="state.label.error">
                        {{ state.label.error }}
                    </div>

                    <div class="alert alert-success" v-if="state.label.labelId && !state.label.error">
                        Frete adicionado ao carrinho com sucesso. Codigo: {{ state.label.labelId }}
                    </div>

                    <div class="alert alert-info" v-if="state.label.checkoutAt && !state.label.error">
                        Frete comprado no Melhor Envio.
                    </div>

                    <div class="alert alert-success" v-if="state.label.generatedAt && !state.label.error">
                        Etiqueta gerada no Melhor Envio.
                    </div>

                    <div class="table-responsive">
                        <table class="table table-sm table-bordered align-middle">
                            <tbody>
                                <tr>
                                    <th style="width: 220px;">Pedido</th>
                                    <td>{{ state.label.orderId }}</td>
                                </tr>
                                <tr>
                                    <th>Destinatario</th>
                                    <td>{{ state.label.recipientName || 'Nao informado' }}</td>
                                </tr>
                                <tr>
                                    <th>CEP</th>
                                    <td>{{ state.label.postCode || 'Nao informado' }}</td>
                                </tr>
                                <tr>
                                    <th>Cidade / Estado</th>
                                    <td>{{ state.label.city || 'Nao informado' }} / {{ state.label.state || 'Nao informado' }}</td>
                                </tr>
                                <tr>
                                    <th>Peso</th>
                                    <td>{{ formatNumber(state.label.weight) }} kg</td>
                                </tr>
                                <tr>
                                    <th>Dimensoes da caixa</th>
                                    <td>{{ state.label.dimensions || 'Nao informado' }}</td>
                                </tr>
                                <tr>
                                    <th>Frete</th>
                                    <td>{{ formatCurrency(state.label.shippingCost) }}</td>
                                </tr>
                                <tr>
                                    <th>Total</th>
                                    <td>{{ formatCurrency(state.label.totalAmount) }}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                    <button type="button" class="btn btn-outline-success" v-if="!state.label.labelId" v-on:click="methods.markShippingCart" v-bind:disabled="state.label.isGenerating">
                        Ja esta no carrinho
                    </button>
                    <button type="button" class="btn btn-success" v-if="state.label.labelId && !state.label.checkoutAt" v-on:click="methods.buyShippingCart" v-bind:disabled="state.label.isBuying || state.label.isGenerating">
                        <span class="spinner-border spinner-border-sm me-2" v-if="state.label.isBuying"></span>
                        <span v-if="state.label.isBuying">Comprando...</span>
                        <span v-else>Comprar frete</span>
                    </button>
                    <button type="button" class="btn btn-success" v-if="state.label.labelId && state.label.checkoutAt && !state.label.generatedAt" v-on:click="methods.generatePurchasedShippingLabel" v-bind:disabled="state.label.isGeneratingPurchased || state.label.isBuying || state.label.isGenerating">
                        <span class="spinner-border spinner-border-sm me-2" v-if="state.label.isGeneratingPurchased"></span>
                        <span v-if="state.label.isGeneratingPurchased">Gerando...</span>
                        <span v-else>Gerar etiqueta</span>
                    </button>
                    <button type="button" class="btn btn-primary" v-on:click="handler.handleGenerateShippingLabel" v-bind:disabled="state.label.isGenerating || !!state.label.labelId">
                        <span class="spinner-border spinner-border-sm me-2" v-if="state.label.isGenerating"></span>
                        <span v-if="state.label.isGenerating">Adicionando...</span>
                        <span v-else>Adicionar ao carrinho</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/FrontEnd/Pages/Orders/Order.cshtml.js" asp-append-version="true"></script>
}
