@page
@{
    ViewData["Title"] = "Pedidos";
}

<style>
    .order-admin {
        background: #f7f7f5;
        color: #171717;
        font-family: "Source Sans Pro", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        min-height: calc(100vh - 120px);
        padding: 28px;
    }

    .order-page-header {
        align-items: center;
        display: flex;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 24px;
    }

    .order-page-title {
        color: #161616;
        font-size: 32px;
        font-weight: 800;
        line-height: 1.1;
        margin: 0;
    }

    .order-header-actions {
        display: inline-flex;
        flex-wrap: wrap;
        gap: 10px;
        justify-content: flex-end;
    }

    .order-add-button {
        align-items: center;
        background: #2563eb;
        border: 1px solid #2563eb;
        border-radius: 10px;
        color: #ffffff;
        display: inline-flex;
        font-size: 14px;
        font-weight: 800;
        gap: 8px;
        min-height: 42px;
        padding: 0 18px;
    }

    .order-add-button:hover {
        background: #1d4ed8;
        border-color: #1d4ed8;
        color: #ffffff;
    }

    .order-secondary-button {
        align-items: center;
        background: #ffffff;
        border: 1px solid #d9dee5;
        border-radius: 9px;
        color: #4b5563;
        display: inline-flex;
        font-size: 14px;
        font-weight: 800;
        gap: 8px;
        min-height: 42px;
        padding: 0 14px;
    }

    .order-secondary-button:hover:not(:disabled) {
        background: #f9fafb;
        color: #111827;
    }

    .order-secondary-button:disabled {
        cursor: not-allowed;
        opacity: 0.55;
    }

    .order-secondary-button--danger {
        border-color: #fecaca;
        color: #dc2626;
    }

    .order-secondary-button--danger:hover:not(:disabled) {
        background: #fff1f2;
        border-color: #fca5a5;
        color: #b91c1c;
    }

    .page-summary-card {
        background: var(--summary-bg, #fff);
        border: 0;
        border-radius: 14px;
        color: var(--summary-text, #111827);
        height: 100%;
        padding: 22px 24px;
    }

    .page-summary-card .label {
        color: var(--summary-muted, #6c757d);
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .page-summary-card .value {
        font-size: 30px;
        font-weight: 900;
        line-height: 1;
    }

    .summary-total {
        --summary-bg: linear-gradient(135deg, #f8fafc 0%, #eef2ff 100%);
        --summary-border: #dbe4ff;
        --summary-muted: #64748b;
        --summary-text: #1e293b;
    }

    .summary-pending {
        --summary-bg: linear-gradient(135deg, #fff7ed 0%, #fef3c7 100%);
        --summary-border: #fed7aa;
        --summary-muted: #9a3412;
        --summary-text: #7c2d12;
    }

    .summary-paid {
        --summary-bg: linear-gradient(135deg, #ecfdf5 0%, #ccfbf1 100%);
        --summary-border: #99f6e4;
        --summary-muted: #047857;
        --summary-text: #064e3b;
    }

    .summary-cancelled {
        --summary-bg: linear-gradient(135deg, #fff1f2 0%, #ffe4e6 100%);
        --summary-border: #fecdd3;
        --summary-muted: #be123c;
        --summary-text: #881337;
    }

    .summary-balance {
        --summary-bg: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
        --summary-border: #bae6fd;
        --summary-muted: #0369a1;
        --summary-text: #0c4a6e;
    }

    .summary-reserved {
        --summary-bg: linear-gradient(135deg, #f5f3ff 0%, #ede9fe 100%);
        --summary-border: #ddd6fe;
        --summary-muted: #6d28d9;
        --summary-text: #4c1d95;
    }

    .summary-debts {
        --summary-bg: linear-gradient(135deg, #fdf2f8 0%, #fae8ff 100%);
        --summary-border: #f5d0fe;
        --summary-muted: #a21caf;
        --summary-text: #701a75;
    }

    .order-table-card {
        background: #ffffff;
        border: 1px solid #e1e5ea;
        border-radius: 14px;
        overflow: hidden;
    }

    .order-table-scroll {
        max-height: calc(100vh - 390px);
        overflow: auto;
    }

    .order-table {
        border-collapse: collapse;
        margin: 0;
        min-width: 1360px;
        table-layout: fixed;
        width: 100%;
    }

    .order-table thead th {
        background: #ffffff;
        border-bottom: 1px solid #e5e7eb;
        color: #374151;
        font-size: 12px;
        font-weight: 800;
        padding: 13px 12px;
        position: sticky;
        text-align: left;
        top: 0;
        vertical-align: middle;
        z-index: 2;
    }

    .order-sort-button {
        align-items: center;
        background: transparent;
        border: 0;
        color: inherit;
        display: inline-flex;
        font: inherit;
        font-weight: 800;
        gap: 7px;
        padding: 0;
        text-align: left;
    }

    .order-sort-button:hover {
        color: #111827;
    }

    .order-sort-icon {
        color: #9ca3af;
        font-size: 11px;
        width: 11px;
    }

    .order-sort-button--active .order-sort-icon {
        color: #2563eb;
    }

    .order-table tbody td {
        border-bottom: 1px solid #edf0f3;
        color: #6b7280;
        font-size: 13px;
        padding: 11px 12px;
        vertical-align: middle;
    }

    .order-table tbody tr:nth-child(even) td {
        background: #fbfcfd;
    }

    .order-table tbody tr:hover td {
        background: #f3f6fb;
    }

    .order-table tbody tr:last-child td {
        border-bottom: 0;
    }

    .order-table__date {
        color: #4b5563;
        font-weight: 800;
        line-height: 1.25;
        white-space: nowrap;
    }

    .order-table__time {
        color: #9ca3af;
        display: block;
        font-size: 12px;
        font-weight: 700;
        margin-top: 2px;
    }

    .order-table__customer {
        color: #171717;
        display: block;
        font-size: 14px;
        font-weight: 800;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .order-table__muted {
        color: #9ca3af;
        display: block;
        font-size: 12px;
        font-weight: 700;
        margin-top: 2px;
    }

    .order-table__actions {
        text-align: right;
        white-space: nowrap;
    }

    .order-payment-label {
        background: #f3f4f6;
        border: 1px solid #e5e7eb;
        border-radius: 999px;
        color: #374151;
        display: inline-flex;
        font-size: 11px;
        font-weight: 900;
        line-height: 1;
        padding: 7px 10px;
        white-space: nowrap;
    }

    .order-total-cell {
        line-height: 1.3;
        white-space: nowrap;
    }

    .order-total-cell__main {
        color: #111827;
        display: block;
        font-size: 14px;
        font-weight: 900;
    }

    .order-total-cell__detail {
        color: #9ca3af;
        display: block;
        font-size: 11px;
        font-weight: 700;
    }

    .order-timeline {
        min-width: 250px;
    }

    .order-timeline__steps {
        align-items: center;
        display: grid;
        grid-template-columns: repeat(7, minmax(0, 1fr));
        margin-bottom: 7px;
    }

    .order-timeline__step {
        align-items: center;
        display: flex;
        min-width: 0;
    }

    .order-timeline__dot {
        align-items: center;
        background: #e5e7eb;
        border: 2px solid #e5e7eb;
        border-radius: 999px;
        color: #6b7280;
        display: inline-flex;
        flex: 0 0 18px;
        font-size: 8px;
        font-weight: 900;
        height: 18px;
        justify-content: center;
        line-height: 1;
        width: 18px;
        z-index: 1;
    }

    .order-timeline__dot .fa,
    .order-timeline__dot .fas {
        line-height: 1;
    }

    .order-timeline__line {
        background: #e5e7eb;
        flex: 1 1 auto;
        height: 2px;
        min-width: 10px;
    }

    .order-timeline__step--complete .order-timeline__dot,
    .order-timeline__step--complete .order-timeline__line {
        background: #22c55e;
        border-color: #22c55e;
        color: #ffffff;
    }

    .order-timeline__step--current .order-timeline__dot {
        background: #2563eb;
        border-color: #2563eb;
        color: #ffffff;
    }

    .order-timeline__step--current .order-timeline__line {
        background: #e5e7eb;
    }

    .order-timeline--cancelled .order-timeline__dot {
        background: #fee2e2;
        border-color: #fecaca;
        color: #991b1b;
    }

    .order-timeline__label {
        color: #111827;
        display: block;
        font-size: 12px;
        font-weight: 900;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .order-timeline__hint {
        color: #9ca3af;
        display: block;
        font-size: 11px;
        font-weight: 700;
        margin-top: 1px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .order-action-button {
        align-items: center;
        background: #ffffff;
        border: 1px solid #d9dee5;
        border-radius: 9px;
        color: #4b5563;
        display: inline-flex;
        font-size: 12px;
        font-weight: 800;
        gap: 7px;
        justify-content: center;
        min-height: 34px;
        padding: 0 11px;
        white-space: nowrap;
    }

    .order-action-button:hover:not(:disabled) {
        background: #f9fafb;
        color: #111827;
    }

    .order-details-count {
        background: #eef2ff;
        border-radius: 999px;
        color: #3730a3;
        font-size: 11px;
        font-weight: 900;
        line-height: 1;
        padding: 4px 7px;
    }

    .order-action-button--success {
        border-color: #bbf7d0;
        color: #15803d;
    }

    .order-action-button--success:hover:not(:disabled) {
        background: #f0fdf4;
        border-color: #86efac;
        color: #166534;
    }

    .order-action-button--bag {
        background: #fdf2f8;
        border-color: #f9a8d4;
        color: #be185d;
    }

    .order-action-button--bag:hover:not(:disabled) {
        background: #fce7f3;
        border-color: #f472b6;
        color: #9d174d;
    }

    .order-action-button--bag-finalize {
        background: #fff7ed;
        border-color: #fdba74;
        color: #c2410c;
    }

    .order-action-button--bag-finalize:hover:not(:disabled) {
        background: #ffedd5;
        border-color: #fb923c;
        color: #9a3412;
    }

    .order-action-button:disabled {
        cursor: not-allowed;
        opacity: 0.65;
    }

    .order-row-action-button {
        align-items: center;
        background: #ffffff;
        border: 1px solid #d9dee5;
        border-radius: 9px;
        color: #4b5563;
        display: inline-flex;
        height: 36px;
        justify-content: center;
        width: 36px;
    }

    .order-row-action-button:hover {
        background: #f9fafb;
        color: #111827;
    }

    .order-row-action-button--danger {
        border-color: #fecaca;
        color: #dc2626;
    }

    .order-row-action-button--danger:hover {
        background: #fff1f2;
        border-color: #fca5a5;
        color: #b91c1c;
    }

    .order-empty-row {
        color: #9ca3af !important;
        padding: 34px 22px !important;
        text-align: center;
    }

    .order-pager {
        align-items: center;
        background: #ffffff;
        border-top: 1px solid #edf0f3;
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        justify-content: space-between;
        padding: 14px 18px;
    }

    .order-pager__text {
        color: #6b7280;
        font-size: 13px;
        font-weight: 700;
    }

    .order-pager__actions {
        display: inline-flex;
        gap: 8px;
    }

    @@media (max-width: 1100px) {
        .order-admin {
            padding: 20px;
        }

        .order-page-header {
            align-items: stretch;
            flex-direction: column;
        }

        .order-header-actions {
            justify-content: stretch;
        }

        .order-add-button,
        .order-secondary-button {
            justify-content: center;
        }

        .order-table-card {
            overflow: hidden;
        }

        .order-table-scroll {
            max-height: 65vh;
        }

        .order-table {
            min-width: 1360px;
        }
    }

    @@media (max-width: 520px) {
        .order-header-actions {
            display: grid;
            grid-template-columns: 1fr;
        }
    }
</style>

<div id="app" class="order-admin" v-cloak>
    <header class="order-page-header">
        <h1 class="order-page-title">Pedidos</h1>
    </header>

    <div class="row mb-3">
        <div class="col-12 col-md-6 col-xl-3 mb-2">
            <div class="page-summary-card summary-total">
                <div class="label">Total de Pedidos</div>
                <div class="value">{{ state.summary.total }}</div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xl-3 mb-2">
            <div class="page-summary-card summary-pending">
                <div class="label">Pendentes</div>
                <div class="value">{{ state.summary.pending }}</div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xl-3 mb-2">
            <div class="page-summary-card summary-paid">
                <div class="label">Pagos</div>
                <div class="value">{{ state.summary.paid }}</div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xl-3 mb-2">
            <div class="page-summary-card summary-cancelled">
                <div class="label">Cancelados</div>
                <div class="value">{{ state.summary.cancelled }}</div>
            </div>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-12 col-md-4 mb-2">
            <div class="page-summary-card summary-balance">
                <div class="label">Saldo Melhor Envio</div>
                <div class="value">
                    <span v-if="state.melhorEnvioBalance.isLoading">Carregando...</span>
                    <span v-else>{{ formatCurrency(state.melhorEnvioBalance.balance) }}</span>
                </div>
                <button type="button" class="btn btn-sm btn-primary mt-2" v-on:click="methods.openInsertBalance" v-bind:disabled="state.melhorEnvioBalance.isInserting">
                    <span class="spinner-border spinner-border-sm me-1" v-if="state.melhorEnvioBalance.isInserting"></span>
                    <i class="fa fa-wallet" v-if="!state.melhorEnvioBalance.isInserting"></i>
                    Inserir saldo
                </button>
                <small class="text-danger" v-if="state.melhorEnvioBalance.error">{{ state.melhorEnvioBalance.error }}</small>
            </div>
        </div>
        <div class="col-12 col-md-4 mb-2">
            <div class="page-summary-card summary-reserved">
                <div class="label">Reservado</div>
                <div class="value">{{ formatCurrency(state.melhorEnvioBalance.reserved) }}</div>
            </div>
        </div>
        <div class="col-12 col-md-4 mb-2">
            <div class="page-summary-card summary-debts">
                <div class="label">Debitos</div>
                <div class="value">{{ formatCurrency(state.melhorEnvioBalance.debts) }}</div>
            </div>
        </div>
    </div>

    <section class="order-table-card">
        <div class="order-table-scroll">
            <table class="order-table">
            <colgroup>
                <col style="width: 130px;">
                <col style="width: 170px;">
                <col style="width: 270px;">
                <col style="width: 150px;">
                <col style="width: 170px;">
                <col style="width: 120px;">
                <col style="width: 92px;">
                <col style="width: 135px;">
                <col style="width: 74px;">
            </colgroup>
            <thead>
                <tr>
                    <th>
                        <button type="button"
                                class="order-sort-button"
                                v-bind:class="{ 'order-sort-button--active': state.sort.field === 'orderDate' }"
                                v-on:click="handler.handleSort('orderDate')">
                            Data do Pedido
                            <i class="fa order-sort-icon" v-bind:class="methods.getSortIcon('orderDate')" aria-hidden="true"></i>
                        </button>
                    </th>
                    <th>
                        <button type="button"
                                class="order-sort-button"
                                v-bind:class="{ 'order-sort-button--active': state.sort.field === 'customerName' }"
                                v-on:click="handler.handleSort('customerName')">
                            Nome do Cliente
                            <i class="fa order-sort-icon" v-bind:class="methods.getSortIcon('customerName')" aria-hidden="true"></i>
                        </button>
                    </th>
                    <th>
                        <button type="button"
                                class="order-sort-button"
                                v-bind:class="{ 'order-sort-button--active': state.sort.field === 'status' }"
                                v-on:click="handler.handleSort('status')">
                            Status
                            <i class="fa order-sort-icon" v-bind:class="methods.getSortIcon('status')" aria-hidden="true"></i>
                        </button>
                    </th>
                    <th>Total</th>
                    <th>Caixa de Papelão</th>
                    <th>Formas de Pagamento</th>
                    <th>Itens</th>
                    <th>Etiqueta</th>
                    <th class="text-right">Ações</th>
                </tr>
            </thead>
            <tbody>
                <tr v-for="order in pagedOrders"
                    v-bind:key="order.id">
                    <td>
                        <span class="order-table__date">
                            {{ methods.formatOrderDate(order).date }}
                            <span class="order-table__time">{{ methods.formatOrderDate(order).time }}</span>
                        </span>
                    </td>
                    <td>
                        <span class="order-table__customer" v-bind:title="order.customerName || '-'">{{ order.customerName || '-' }}</span>
                        <span class="order-table__muted" v-if="order.shippingPostCode">CEP {{ order.shippingPostCode }}</span>
                    </td>
                    <td>
                        <div class="order-timeline"
                             v-bind:class="{ 'order-timeline--cancelled': order.status === 'Cancelled' }"
                             v-bind:title="methods.getOrderTimelineTitle(order)">
                            <div class="order-timeline__steps">
                                <span class="order-timeline__step"
                                      v-for="step in methods.getOrderTimelineSteps(order)"
                                      v-bind:key="step.key"
                                      v-bind:class="{
                                          'order-timeline__step--complete': step.isComplete,
                                          'order-timeline__step--current': step.isCurrent
                                      }"
                                      v-bind:title="step.description">
                                    <span class="order-timeline__dot">
                                        <i v-bind:class="step.iconClass" aria-hidden="true"></i>
                                    </span>
                                    <span class="order-timeline__line" v-if="!step.isLast"></span>
                                </span>
                            </div>
                            <span class="order-timeline__label">{{ methods.getOrderTimelineCurrent(order).label }}</span>
                            <span class="order-timeline__hint">{{ methods.getOrderTimelineCurrent(order).description }}</span>
                        </div>
                    </td>
                    <td>
                        <span class="order-total-cell"
                              v-bind:title="methods.getTotalTitle(order)">
                            <span class="order-total-cell__main">{{ formatCurrency(methods.getOrderFinalTotal(order)) }}</span>
                            <span class="order-total-cell__detail">Roupas: {{ formatCurrency(methods.getOrderItemsTotal(order)) }}</span>
                            <span class="order-total-cell__detail">Frete: {{ formatCurrency(methods.getOrderShippingCost(order)) }}</span>
                        </span>
                    </td>
                    <td>
                        <span v-bind:title="methods.formatRowShippingBoxData(order)">
                            {{ methods.formatRowShippingBoxData(order) || '-' }}
                        </span>
                    </td>
                    <td>
                        <span class="order-payment-label"
                              v-bind:title="order.paymentMethod || order.paymentTypeName || '-'">
                            {{ methods.getPaymentMethodLabel(order) }}
                        </span>
                    </td>
                    <td>
                        <button type="button"
                                class="order-action-button"
                                title="Ver itens do pedido"
                                v-on:click.stop="methods.showOrderDetails(order.id)">
                            <i class="fa fa-list" aria-hidden="true"></i>
                            Ver
                            <span class="order-details-count">{{ order.itemCount || 0 }}</span>
                        </button>
                    </td>
                    <td>
                        <button type="button"
                                class="order-action-button"
                                v-bind:class="methods.getShippingLabelButtonClass(order)"
                                v-bind:title="methods.getShippingLabelTitle(order)"
                                v-bind:disabled="order.status !== 'Paid'"
                                v-on:click.stop="methods.openShippingLabel(order)">
                            <i class="fa" v-bind:class="methods.getShippingLabelIcon(order)" aria-hidden="true"></i>
                            {{ methods.getShippingLabelText(order) }}
                        </button>
                    </td>
                    <td class="order-table__actions">
                        <button type="button"
                                class="order-row-action-button order-row-action-button--danger"
                                title="Excluir"
                                v-on:click.stop="handler.handleDelete(order)">
                            <i class="fas fa-trash-alt" aria-hidden="true"></i>
                        </button>
                    </td>
                </tr>
                <tr v-if="pagedOrders.length === 0">
                    <td colspan="9" class="order-empty-row">Nenhum pedido encontrado.</td>
                </tr>
            </tbody>
            </table>
        </div>

        <div class="order-pager" v-if="sortedOrders.length > 0">
            <span class="order-pager__text">
                {{ methods.getPagerText() }}
            </span>
            <div class="order-pager__actions">
                <button type="button" class="order-secondary-button" v-on:click="handler.handlePreviousPage" v-bind:disabled="state.pagination.page === 1">
                    <i class="fa fa-chevron-left" aria-hidden="true"></i>
                    Anterior
                </button>
                <button type="button" class="order-secondary-button" v-on:click="handler.handleNextPage" v-bind:disabled="state.pagination.page >= totalPages">
                    Proxima
                    <i class="fa fa-chevron-right" aria-hidden="true"></i>
                </button>
            </div>
        </div>
    </section>

    <div class="modal fade" ref="mainModalRef" id="MainModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-scrollable modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">{{ state.mainTitle }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" v-model="state.id" />

                    <div class="alert alert-danger" v-if="state.deleteMode">
                        Confirme a exclusao deste pedido.
                    </div>

                    <div class="row mb-3">
                        <div class="col-4">
                            <label>Cliente</label>
                            <select class="form-select" v-model="state.customerId" v-on:change="methods.handleCustomerChange" v-bind:disabled="state.deleteMode">
                                <option value="">Selecione</option>
                                <option v-for="item in state.customers" :value="item.id">{{ item.name }}</option>
                            </select>
                            <small class="text-danger" v-if="state.errors.customerId">{{ state.errors.customerId }}</small>
                        </div>
                        <div class="col-4">
                            <label>Status</label>
                            <select class="form-select" v-model="state.status" v-bind:disabled="state.deleteMode">
                                <option v-for="item in state.orderStatuses" :value="item">{{ translateStatus(item) }}</option>
                            </select>
                            <div class="order-timeline mt-2"
                                 v-bind:class="{ 'order-timeline--cancelled': state.status === 'Cancelled' }"
                                 v-bind:title="methods.getOrderTimelineTitle({ status: state.status })">
                                <div class="order-timeline__steps">
                                    <span class="order-timeline__step"
                                          v-for="step in methods.getOrderTimelineSteps({ status: state.status })"
                                          v-bind:key="step.key"
                                          v-bind:class="{
                                              'order-timeline__step--complete': step.isComplete,
                                              'order-timeline__step--current': step.isCurrent
                                          }"
                                          v-bind:title="step.description">
                                        <span class="order-timeline__dot">
                                            <i v-bind:class="step.iconClass" aria-hidden="true"></i>
                                        </span>
                                        <span class="order-timeline__line" v-if="!step.isLast"></span>
                                    </span>
                                </div>
                                <span class="order-timeline__label">{{ methods.getOrderTimelineCurrent({ status: state.status }).label }}</span>
                                <span class="order-timeline__hint">{{ methods.getOrderTimelineCurrent({ status: state.status }).description }}</span>
                            </div>
                        </div>
                        <div class="col-4">
                            <label>Data do Pedido</label>
                            <input type="text" class="form-control" :value="formatDate(state.orderDate)" disabled />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-3">
                            <label>Desconto</label>
                            <input type="number" class="form-control" v-model.number="state.discount" v-on:input="handler.recalculateTotal" v-bind:disabled="state.deleteMode" />
                        </div>
                        <div class="col-3">
                            <label>Taxas</label>
                            <input type="number" class="form-control" v-model.number="state.taxes" v-on:input="handler.recalculateTotal" v-bind:disabled="state.deleteMode" />
                        </div>
                        <div class="col-3">
                            <label>Frete</label>
                            <input type="number" class="form-control" v-model.number="state.shippingCost" disabled />
                        </div>
                        <div class="col-3">
                            <label>Valor Total</label>
                            <input type="number" class="form-control" v-model.number="state.totalAmount" disabled />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-4">
                            <label>Caixa de Envio</label>
                            <div class="input-group">
                                <select class="form-select" v-model="state.shippingBoxId" v-on:change="methods.handleShippingBoxChange" v-bind:disabled="state.deleteMode">
                                    <option value="">Selecione</option>
                                    <option v-for="item in getCompatibleShippingBoxes()" :value="item.id">
                                        {{ item.name || 'Embalagem' }} — {{ item.capacityPoints }} pontos — estoque {{ item.stockQuantity }}
                                    </option>
                                </select>
                                <button type="button" class="btn btn-outline-secondary" v-on:click="methods.showShippingBoxInfo" v-bind:disabled="!state.shippingBoxId">
                                    <i class="fa fa-info-circle"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-8">
                            <label>Notas</label>
                            <textarea class="form-control" v-model="state.notes" rows="1" v-bind:disabled="state.deleteMode"></textarea>
                        </div>
                    </div>

                    <div class="row mb-3" v-if="state.shippingBoxId">
                        <div class="col-12">
                            <div class="border rounded p-3 bg-light">
                                <div class="mb-2"><strong>Embalagem sugerida automaticamente</strong></div>
                                <div class="row g-3">
                                    <div class="col-2">
                                        <small class="text-muted d-block">Largura</small>
                                        <strong>{{ formatNumber(getSelectedShippingBox()?.width) }} cm</strong>
                                    </div>
                                    <div class="col-2">
                                        <small class="text-muted d-block">Comprimento</small>
                                        <strong>{{ formatNumber(getSelectedShippingBox()?.length) }} cm</strong>
                                    </div>
                                    <div class="col-2">
                                        <small class="text-muted d-block">Altura</small>
                                        <strong>{{ formatNumber(getSelectedShippingBox()?.height) }} cm</strong>
                                    </div>
                                    <div class="col-2">
                                        <small class="text-muted d-block">Peso</small>
                                        <strong>{{ formatNumber(getSelectedShippingBox()?.weight) }} kg</strong>
                                    </div>
                                    <div class="col-2">
                                        <small class="text-muted d-block">Peso Cobrado</small>
                                        <strong>{{ formatNumber(calculateChargedWeight(getSelectedShippingBox())) }} kg</strong>
                                    </div>
                                    <div class="col-2">
                                        <small class="text-muted d-block">Frete</small>
                                        <strong>{{ formatCurrency(state.shippingCost) }}</strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <h5 class="mt-4">Itens do Pedido</h5>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead>
                                <tr>
                                    <th>Produto</th>
                                    <th style="width: 120px;">Qtd</th>
                                    <th style="width: 160px;">Preco Unitario</th>
                                    <th style="width: 140px;">Total do Produto</th>
                                    <th style="width: 140px;">Frete do Produto</th>
                                    <th style="width: 70px;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr v-for="(item, index) in state.orderDetails" :key="index">
                                    <td>
                                        <select class="form-select" v-model="item.productId" v-on:change="methods.handleProductChange(item)" v-bind:disabled="state.deleteMode">
                                            <option value="">Selecione</option>
                                            <option v-for="product in state.products" :value="product.id">{{ product.name }}</option>
                                        </select>
                                    </td>
                                    <td>
                                        <input type="number" min="1" class="form-control" v-model.number="item.quantity" v-on:input="handler.recalculateTotal" v-bind:disabled="state.deleteMode" />
                                    </td>
                                    <td>
                                        <input type="number" class="form-control" v-model.number="item.unitPrice" v-on:input="handler.recalculateTotal" v-bind:disabled="state.deleteMode" />
                                    </td>
                                    <td>{{ formatCurrency(getItemTotal(item)) }}</td>
                                    <td>{{ formatCurrency(getItemShippingCost(item)) }}</td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-sm btn-outline-danger" v-on:click="methods.removeOrderItem(index)" v-bind:disabled="state.deleteMode">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                                <tr v-if="!state.orderDetails.length">
                                    <td colspan="6" class="text-muted text-center">Nenhum item adicionado.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <small class="text-danger" v-if="state.errors.orderDetails">{{ state.errors.orderDetails }}</small>
                        <button type="button" class="btn btn-sm btn-outline-primary ms-auto" v-on:click="methods.addOrderItem" v-bind:disabled="state.deleteMode">
                            <i class="fa fa-plus"></i> Adicionar Item
                        </button>
                    </div>

                    <h5 class="mt-4">Detalhes do Pagamento</h5>
                    <div class="row mb-3">
                        <div class="col-4">
                            <label>Status do Pagamento</label>
                            <select class="form-select" v-model="state.payment.status" v-bind:disabled="state.deleteMode">
                                <option v-for="item in state.paymentStatuses" :value="item">{{ translateStatus(item) }}</option>
                            </select>
                        </div>
                        <div class="col-4">
                            <label>Forma de Pagamento</label>
                            <select class="form-select" v-model="state.payment.paymentTypeId" v-bind:disabled="state.deleteMode">
                                <option value="">Selecione</option>
                                <option v-for="item in state.paymentTypes" :value="item.id">{{ item.typeName }}</option>
                            </select>
                        </div>
                        <div class="col-4">
                            <label>Valor</label>
                            <input type="number" class="form-control" v-model.number="state.payment.amount" v-bind:disabled="state.deleteMode" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-4">
                            <label>Data do Pagamento</label>
                            <input type="datetime-local" class="form-control" v-model="state.payment.paymentDateTime" v-bind:disabled="state.deleteMode" />
                        </div>
                        <div class="col-4">
                            <label>ID da Transacao</label>
                            <input type="text" class="form-control" v-model="state.payment.transactionId" v-bind:disabled="state.deleteMode" />
                        </div>
                        <div class="col-4">
                            <label>Codigo de Autorizacao</label>
                            <input type="text" class="form-control" v-model="state.payment.authorizationCode" v-bind:disabled="state.deleteMode" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-4">
                            <label>Metodo de Pagamento</label>
                            <input type="text" class="form-control" v-model="state.payment.paymentMethod" v-bind:disabled="state.deleteMode" />
                        </div>
                        <div class="col-4">
                            <label>Nome no Cartao</label>
                            <input type="text" class="form-control" v-model="state.payment.cardHolderName" v-bind:disabled="state.deleteMode" />
                        </div>
                        <div class="col-4">
                            <label>Ultimos 4 Digitos</label>
                            <input type="text" class="form-control" v-model="state.payment.cardLast4" v-bind:disabled="state.deleteMode" />
                        </div>
                    </div>

                    <h5 class="mt-4">Detalhes do Envio</h5>
                    <div class="row mb-3">
                        <div class="col-3">
                            <label>Nome</label>
                            <input type="text" class="form-control" v-model="state.shipping.firstName" v-bind:disabled="state.deleteMode" />
                        </div>
                        <div class="col-3">
                            <label>Sobrenome</label>
                            <input type="text" class="form-control" v-model="state.shipping.lastName" v-bind:disabled="state.deleteMode" />
                        </div>
                        <div class="col-3">
                            <label>Email</label>
                            <input type="email" class="form-control" v-model="state.shipping.email" v-bind:disabled="state.deleteMode" />
                        </div>
                        <div class="col-3">
                            <label>Telefone</label>
                            <input type="text" class="form-control" v-model="state.shipping.phoneNumber" v-bind:disabled="state.deleteMode" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-4">
                            <label>Rua</label>
                            <input type="text" class="form-control" v-model="state.shipping.street" v-bind:disabled="state.deleteMode" />
                        </div>
                        <div class="col-2">
                            <label>Numero</label>
                            <input type="text" class="form-control" v-model="state.shipping.number" v-bind:disabled="state.deleteMode" />
                        </div>
                        <div class="col-3">
                            <label>Bairro</label>
                            <input type="text" class="form-control" v-model="state.shipping.neighborhood" v-bind:disabled="state.deleteMode" />
                        </div>
                        <div class="col-3">
                            <label>Complemento</label>
                            <input type="text" class="form-control" v-model="state.shipping.complement" v-bind:disabled="state.deleteMode" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-3">
                            <label>Cidade</label>
                            <input type="text" class="form-control" v-model="state.shipping.city" v-bind:disabled="state.deleteMode" />
                        </div>
                        <div class="col-3">
                            <label>Estado</label>
                            <input type="text" class="form-control" v-model="state.shipping.state" v-bind:disabled="state.deleteMode" />
                        </div>
                        <div class="col-3">
                            <label>CEP</label>
                            <input type="text" class="form-control" v-model="state.shipping.postCode" v-on:blur="methods.refreshShippingCost" v-bind:disabled="state.deleteMode" />
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                    <button type="button" id="MainSaveButton" v-bind:class="state.deleteMode ? 'btn btn-danger' : 'btn btn-primary'" v-on:click="handler.handleSubmit" v-bind:disabled="state.isSubmitting">
                        <span class="spinner-border spinner-border-sm me-2" v-if="state.isSubmitting"></span>
                        <span v-if="!state.isSubmitting">{{ state.deleteMode ? 'Excluir' : 'Salvar' }}</span>
                        <span v-else>{{ state.deleteMode ? 'Excluindo...' : 'Salvando...' }}</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" ref="labelModalRef" id="ShippingLabelModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-scrollable modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Sacolinha Melhor Envio</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <div class="alert alert-danger" v-if="state.label.error">
                        {{ state.label.error }}
                    </div>

                    <div class="alert alert-success" v-if="state.label.labelId && !state.label.error">
                        Frete adicionado a sacolinha com sucesso. Codigo: {{ state.label.labelId }}
                    </div>

                    <div class="alert alert-info" v-if="state.label.checkoutAt && !state.label.error">
                        Sacolinha finalizada no Melhor Envio.
                    </div>

                    <div class="alert alert-success" v-if="state.label.generatedAt && !state.label.error">
                        Etiqueta gerada no Melhor Envio.
                    </div>

                    <div class="table-responsive">
                        <table class="table table-sm table-bordered align-middle">
                            <tbody>
                                <tr>
                                    <th style="width: 220px;">Pedido</th>
                                    <td>{{ state.label.orderId }}</td>
                                </tr>
                                <tr>
                                    <th>Destinatario</th>
                                    <td>{{ state.label.recipientName || 'Nao informado' }}</td>
                                </tr>
                                <tr>
                                    <th>CEP</th>
                                    <td>{{ state.label.postCode || 'Nao informado' }}</td>
                                </tr>
                                <tr>
                                    <th>Cidade / Estado</th>
                                    <td>{{ state.label.city || 'Nao informado' }} / {{ state.label.state || 'Nao informado' }}</td>
                                </tr>
                                <tr>
                                    <th>Peso</th>
                                    <td>{{ formatNumber(state.label.weight) }} kg</td>
                                </tr>
                                <tr>
                                    <th>Dimensoes da caixa</th>
                                    <td>{{ state.label.dimensions || 'Nao informado' }}</td>
                                </tr>
                                <tr>
                                    <th>Frete</th>
                                    <td>{{ formatCurrency(state.label.shippingCost) }}</td>
                                </tr>
                                <tr>
                                    <th>Total</th>
                                    <td>{{ formatCurrency(state.label.totalAmount) }}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                    <button type="button" class="btn btn-outline-success" v-if="!state.label.labelId" v-on:click="methods.markShippingCart" v-bind:disabled="state.label.isGenerating">
                        <i class="fa fa-shopping-bag me-1" aria-hidden="true"></i>
                        Ja esta na sacolinha
                    </button>
                    <button type="button" class="btn btn-success" v-if="state.label.labelId && !state.label.checkoutAt" v-on:click="methods.buyShippingCart" v-bind:disabled="state.label.isBuying || state.label.isGenerating">
                        <span class="spinner-border spinner-border-sm me-2" v-if="state.label.isBuying"></span>
                        <span v-if="state.label.isBuying">Finalizando...</span>
                        <span v-else>
                            <i class="fa fa-shopping-bag me-1" aria-hidden="true"></i>
                            Finalizar sacolinha
                        </span>
                    </button>
                    <button type="button" class="btn btn-success" v-if="state.label.labelId && state.label.checkoutAt && !state.label.generatedAt" v-on:click="methods.generatePurchasedShippingLabel" v-bind:disabled="state.label.isGeneratingPurchased || state.label.isBuying || state.label.isGenerating">
                        <span class="spinner-border spinner-border-sm me-2" v-if="state.label.isGeneratingPurchased"></span>
                        <span v-if="state.label.isGeneratingPurchased">Gerando...</span>
                        <span v-else>Gerar etiqueta</span>
                    </button>
                    <button type="button" class="btn btn-primary" v-on:click="handler.handleGenerateShippingLabel" v-bind:disabled="state.label.isGenerating || !!state.label.labelId">
                        <span class="spinner-border spinner-border-sm me-2" v-if="state.label.isGenerating"></span>
                        <span v-if="state.label.isGenerating">Adicionando...</span>
                        <span v-else>
                            <i class="fa fa-shopping-bag me-1" aria-hidden="true"></i>
                            Adicionar a sacolinha
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    <script src="~/FrontEnd/Pages/Orders/Order.cshtml.js" asp-append-version="true"></script>
}
