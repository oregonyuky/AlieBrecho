@page
@{
    ViewData["Title"] = "Site";
}

<style>
    .site-settings { max-width: 760px; }
    .site-settings__card { background: #fff; border: 1px solid #dde3ea; border-radius: 8px; box-shadow: 0 10px 28px rgba(31, 41, 51, .08); padding: 24px; }
    .site-settings__preview { align-items: center; background: #f4f6f9; border: 1px dashed #aeb8c3; border-radius: 12px; display: flex; justify-content: center; margin: 18px 0; min-height: 280px; overflow: hidden; }
    .site-settings__preview img { display: block; max-height: 420px; max-width: 100%; object-fit: contain; }
    .site-settings__actions { align-items: center; display: flex; flex-wrap: wrap; gap: 12px; }
    .site-settings__status { margin: 14px 0 0; }
</style>

<div class="site-settings">
    <div class="site-settings__card">
        <h1 class="h4 mb-2">Imagem da página inicial</h1>
        <p class="text-muted">Escolha a imagem exibida na lateral direita do destaque principal do site.</p>

        <div class="site-settings__preview">
            <img id="heroPreview" alt="Prévia da imagem do destaque" hidden />
            <span id="heroEmpty" class="text-muted">Nenhuma imagem selecionada</span>
        </div>

        <div class="site-settings__actions">
            <input id="heroImageInput" type="file" accept="image/png,image/jpeg,image/webp,image/gif" class="form-control" />
            <button id="saveHeroImage" type="button" class="btn btn-primary">Salvar imagem</button>
        </div>
        <p id="siteSettingsStatus" class="site-settings__status" role="status"></p>
    </div>
</div>

@section scripts {
    <script src="~/FrontEnd/Pages/Site/SiteSettings.cshtml.js?v=20260721-1"></script>
}
