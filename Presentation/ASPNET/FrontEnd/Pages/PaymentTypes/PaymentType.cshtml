@page
@{
    ViewData["Title"] = "Forma de Pagamento";
}

<div id="app" v-cloak>
    <div class="row">
        <div class="col-12">
            <div class="grid-container">
                <div ref="mainGridRef"></div>
            </div>
        </div>
    </div>

    <div class="modal fade" ref="mainModalRef" id="MainModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-md">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">{{ state.mainTitle }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" v-model="state.id" />

                    <form id="MainForm">
                        <div class="row mb-2">
                            <div class="col-12">
                                <label>Nome do Tipo</label>
                                <input ref="typeNameRef"
                                       v-model="state.typeName"
                                       type="text"
                                       class="form-control"
                                       v-bind:disabled="state.deleteMode">
                                <label class="text-danger">{{ state.errors.typeName }}</label>
                            </div>
                        </div>

                        <div class="row mb-2">
                            <div class="col-12">
                                <label>Descricao</label>
                                <textarea ref="descriptionRef"
                                          v-model="state.description"
                                          class="form-control"
                                          rows="3"
                                          v-bind:disabled="state.deleteMode"></textarea>
                                <label class="text-danger">{{ state.errors.description }}</label>
                            </div>
                        </div>

                        <div class="row mb-2">
                            <div class="col-12 form-check">
                                <input type="checkbox"
                                       class="form-check-input"
                                       id="IsActive"
                                       v-model="state.isActive"
                                       v-bind:disabled="state.deleteMode">
                                <label class="form-check-label" for="IsActive">
                                    Ativo
                                </label>
                            </div>
                        </div>
                    </form>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Fechar
                    </button>

                    <button type="button"
                            id="MainSaveButton"
                            class="btn"
                            v-bind:class="state.deleteMode ? 'btn-danger' : 'btn-primary'"
                            v-on:click="handler.handleSubmit"
                            v-bind:disabled="state.isSubmitting">

                        <span class="spinner-border spinner-border-sm me-2"
                              v-if="state.isSubmitting"></span>

                        <span v-if="!state.isSubmitting">
                            {{ state.deleteMode ? 'Excluir' : 'Salvar' }}
                        </span>

                        <span v-else>
                            {{ state.deleteMode ? 'Excluindo...' : 'Salvando...' }}
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/FrontEnd/Pages/PaymentTypes/PaymentType.cshtml.js?v=20260708"></script>
}
