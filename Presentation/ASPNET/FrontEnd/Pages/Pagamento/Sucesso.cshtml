@page "/pagamento/sucesso"
@{
    Layout = "~/FrontEnd/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Pagamento";
}

<main class="payment-return">
    <section class="payment-return__panel">
        <div class="payment-return__icon">
            <i class="fas fa-check"></i>
        </div>
        <h1>Pagamento recebido</h1>
        <p>
            Obrigado. Se o pagamento ainda estiver em processamento, o pedido sera atualizado automaticamente quando a InfinitePay confirmar o status.
        </p>
        <a asp-page="/Orders/Order" class="payment-return__button">Ver pedidos</a>
    </section>
</main>

<style>
    .payment-return {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 32px 16px;
        background: #f5f6f8;
        color: #212529;
        font-family: "Open Sans", Arial, sans-serif;
    }

    .payment-return__panel {
        width: min(100%, 520px);
        padding: 32px;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        background: #ffffff;
        text-align: center;
        box-shadow: 0 10px 30px rgba(33, 37, 41, 0.08);
    }

    .payment-return__icon {
        width: 56px;
        height: 56px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 18px;
        border-radius: 50%;
        background: #198754;
        color: #ffffff;
        font-size: 24px;
    }

    .payment-return h1 {
        margin: 0 0 12px;
        font-size: 28px;
        font-weight: 700;
    }

    .payment-return p {
        margin: 0 0 24px;
        color: #5c636a;
        line-height: 1.55;
    }

    .payment-return__button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 0 18px;
        border-radius: 6px;
        background: #212529;
        color: #ffffff;
        text-decoration: none;
        font-weight: 600;
    }

    .payment-return__button:hover {
        color: #ffffff;
        background: #343a40;
    }
</style>
