@page
@{
    ViewData["Title"] = "Categoria";
}

<style>
    .page-summary-card {
        border: 1px solid #e9ecef;
        border-radius: 8px;
        padding: 12px 14px;
        background: #fff;
        height: 100%;
    }

    .page-summary-card .label {
        font-size: 0.8rem;
        color: #6c757d;
        margin-bottom: 4px;
    }

    .page-summary-card .value {
        font-size: 1.4rem;
        font-weight: 700;
        line-height: 1;
    }
</style>

<div id="app">
    <div class="row mb-3">
        <div class="col-12 col-md-4 mb-2">
            <div class="page-summary-card">
                <div class="label">Total de Categorias</div>
                <div class="value">{{ state.summary.total }}</div>
            </div>
        </div>
        <div class="col-12 col-md-4 mb-2">
            <div class="page-summary-card">
                <div class="label">Ativas</div>
                <div class="value">{{ state.summary.active }}</div>
            </div>
        </div>
        <div class="col-12 col-md-4 mb-2">
            <div class="page-summary-card">
                <div class="label">Inativas</div>
                <div class="value">{{ state.summary.inactive }}</div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="grid-container">
                <div ref="mainGridRef"></div>
            </div>
        </div>
    </div>

    <div class="modal fade" ref="mainModalRef" id="MainModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-md">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">{{ state.mainTitle }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" v-model="state.id" />

                    <form id="MainForm">
                        <div class="row mb-2">
                            <div class="col-12">
                                <label>Nome</label>
                                <input ref="nameRef"
                                       v-model="state.name"
                                       type="text"
                                       class="form-control"
                                       v-bind:disabled="state.deleteMode">
                                <label class="text-danger">{{ state.errors.name }}</label>
                            </div>
                        </div>

                        <div class="row mb-2">
                            <div class="col-12">
                                <label>Descricao</label>
                                <textarea ref="descriptionRef"
                                          v-model="state.description"
                                          class="form-control"
                                          rows="3"
                                          v-bind:disabled="state.deleteMode"></textarea>
                                <label class="text-danger">{{ state.errors.description }}</label>
                            </div>
                        </div>

                        <div class="row mb-2">
                            <div class="col-12 form-check">
                                <input type="checkbox"
                                       class="form-check-input"
                                       id="IsActive"
                                       v-model="state.isActive"
                                       v-bind:disabled="state.deleteMode">
                                <label class="form-check-label" for="IsActive">
                                    Ativo
                                </label>
                            </div>
                        </div>
                    </form>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Fechar
                    </button>

                    <button type="button"
                            id="MainSaveButton"
                            class="btn"
                            v-bind:class="state.deleteMode ? 'btn-danger' : 'btn-primary'"
                            v-on:click="handler.handleSubmit"
                            v-bind:disabled="state.isSubmitting">

                        <span class="spinner-border spinner-border-sm me-2"
                              v-if="state.isSubmitting"></span>

                        <span v-if="!state.isSubmitting">
                            {{ state.deleteMode ? 'Excluir' : 'Salvar' }}
                        </span>

                        <span v-else>
                            {{ state.deleteMode ? 'Excluindo...' : 'Salvando...' }}
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/FrontEnd/Pages/Categories/Category.cshtml.js?v=20260516"></script>
}
