@page
@{
    ViewData["Title"] = "Categorias";
}

<style>
    .category-admin {
        background: #f7f7f5;
        color: #171717;
        font-family: "Source Sans Pro", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        min-height: calc(100vh - 120px);
        padding: 28px;
    }

    .category-page-header {
        align-items: center;
        display: flex;
        gap: 18px;
        justify-content: space-between;
        margin-bottom: 24px;
    }

    .category-page-title {
        color: #161616;
        font-size: 32px;
        font-weight: 800;
        line-height: 1.1;
        margin: 0;
    }

    .category-add-button {
        align-items: center;
        background: #2563eb;
        border: 1px solid #2563eb;
        border-radius: 10px;
        color: #ffffff;
        display: inline-flex;
        font-size: 14px;
        font-weight: 800;
        gap: 8px;
        min-height: 42px;
        padding: 0 18px;
    }

    .category-add-button:hover {
        background: #1d4ed8;
        border-color: #1d4ed8;
        color: #ffffff;
    }

    .category-summary-grid {
        display: grid;
        gap: 18px;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        margin-bottom: 26px;
    }

    .category-summary-card {
        background: #ffffff;
        border: 0;
        border-radius: 14px;
        padding: 22px 24px;
    }

    .category-summary-card__label {
        color: #777b82;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .category-summary-card__value {
        color: #111827;
        font-size: 30px;
        font-weight: 900;
        line-height: 1;
    }

    .category-summary-card__value--green {
        color: #16a34a;
    }

    .category-summary-card__value--red {
        color: #dc2626;
    }

    .category-filters {
        display: grid;
        gap: 16px;
        grid-template-columns: minmax(0, 1fr) 220px;
        margin-bottom: 24px;
    }

    .category-filter-control {
        background: #ffffff;
        border: 1px solid #d8dce1;
        border-radius: 10px;
        color: #1f2937;
        font-size: 14px;
        min-height: 44px;
        outline: none;
        padding: 0 14px;
        width: 100%;
    }

    .category-filter-control:focus {
        border-color: #9ca3af;
        box-shadow: 0 0 0 3px rgba(156, 163, 175, 0.16);
    }

    .category-table-card {
        background: #ffffff;
        border: 1px solid #e1e5ea;
        border-radius: 14px;
        overflow: hidden;
    }

    .category-table {
        border-collapse: collapse;
        margin: 0;
        width: 100%;
    }

    .category-table thead th {
        background: #ffffff;
        border-bottom: 1px solid #e5e7eb;
        color: #374151;
        font-size: 13px;
        font-weight: 800;
        padding: 14px 18px;
        text-align: left;
    }

    .category-table tbody td {
        border-bottom: 1px solid #edf0f3;
        color: #6b7280;
        font-size: 14px;
        padding: 12px 18px;
        vertical-align: middle;
    }

    .category-table tbody tr:last-child td {
        border-bottom: 0;
    }

    .category-table__name {
        color: #171717;
        font-size: 15px;
        font-weight: 800;
    }

    .category-table__date {
        color: #4b5563;
        font-weight: 800;
        line-height: 1.25;
        white-space: nowrap;
    }

    .category-table__time {
        color: #9ca3af;
        display: block;
        font-size: 12px;
        font-weight: 700;
        margin-top: 2px;
    }

    .category-table__actions {
        text-align: right;
        white-space: nowrap;
    }

    .category-sort-button {
        align-items: center;
        background: transparent;
        border: 0;
        color: inherit;
        display: inline-flex;
        font: inherit;
        font-weight: 800;
        gap: 7px;
        padding: 0;
    }

    .category-sort-button:hover {
        color: #111827;
    }

    .category-sort-icon {
        color: #9ca3af;
        font-size: 11px;
        width: 11px;
    }

    .category-sort-button--active .category-sort-icon {
        color: #2563eb;
    }

    .category-status {
        border-radius: 999px;
        display: inline-flex;
        font-size: 12px;
        font-weight: 900;
        line-height: 1;
        padding: 7px 12px;
        white-space: nowrap;
    }

    .category-status--active {
        background: #dcfce7;
        color: #166534;
    }

    .category-status--inactive {
        background: #fee2e2;
        color: #991b1b;
    }

    .category-action-button {
        align-items: center;
        background: #ffffff;
        border: 1px solid #d9dee5;
        border-radius: 9px;
        color: #4b5563;
        display: inline-flex;
        height: 36px;
        justify-content: center;
        margin-left: 8px;
        width: 36px;
    }

    .category-action-button:hover {
        background: #f9fafb;
        color: #111827;
    }

    .category-action-button--danger {
        border-color: #fecaca;
        color: #dc2626;
    }

    .category-action-button--danger:hover {
        background: #fff1f2;
        border-color: #fca5a5;
        color: #b91c1c;
    }

    .category-empty-row {
        color: #9ca3af !important;
        padding: 34px 22px !important;
        text-align: center;
    }

    .category-modal {
        border: 1px solid #dde3ea;
        border-radius: 8px;
        border-top: 4px solid #222831;
        box-shadow: 0 10px 28px rgba(31, 41, 51, 0.08);
        overflow: hidden;
    }

    .category-modal .modal-header,
    .category-modal .modal-footer {
        background: #ffffff;
        border-color: #e1e7ee;
    }

    .category-modal .modal-title {
        color: #222831;
        font-size: 14px;
        font-weight: 800;
    }

    .category-modal form label {
        color: #59636f;
        font-size: 11px;
        font-weight: 700;
        margin: 0 0 5px;
    }

    .category-modal form .form-control {
        background: #fbfcfd;
        border: 1px solid #cfd7df;
        border-radius: 6px;
        color: #18212c;
        font-size: 14px;
        font-weight: 700;
        outline: none;
        padding: 9px 12px;
        width: 100%;
    }

    .category-modal form .form-control:focus {
        background: #ffffff;
        border-color: #222831;
        box-shadow: 0 0 0 3px rgba(34, 40, 49, 0.08);
    }

    .category-modal form textarea.form-control {
        min-height: 104px;
        resize: vertical;
    }

    .category-modal .form-check {
        align-items: center;
        display: flex;
        gap: 8px;
        min-height: 42px;
        overflow: visible;
        padding-left: 0;
    }

    .category-modal .form-check-input {
        accent-color: #222831;
        flex: 0 0 18px;
        float: none;
        height: 18px;
        margin: 0;
        position: static;
        width: 18px;
    }

    .category-modal .form-check-label {
        color: #18212c;
        cursor: pointer;
        font-size: 13px;
        font-weight: 800;
        line-height: 1.2;
        margin: 0;
        user-select: none;
    }

    .category-drop-btn {
        align-items: center;
        border: 1px solid #cfd7df;
        border-radius: 7px;
        cursor: pointer;
        display: inline-flex;
        font-size: 12px;
        font-weight: 800;
        gap: 7px;
        justify-content: center;
        min-height: 36px;
        padding: 0 16px;
    }

    .category-drop-btn--primary {
        background: #222831;
        border-color: #222831;
        color: #ffffff;
    }

    .category-drop-btn--ghost {
        background: #ffffff;
        color: #222831;
    }

    .category-drop-btn--danger {
        background: #ffffff;
        color: #dc2626;
    }

    .category-drop-btn--primary:hover {
        background: #111827;
        border-color: #111827;
        color: #ffffff;
    }

    .category-drop-btn--ghost:hover {
        background: #f3f5f7;
        border-color: #aeb8c3;
        color: #222831;
    }

    .category-drop-btn--danger:hover {
        background: #fff1f2;
        border-color: #fca5a5;
        color: #dc2626;
    }

    .category-drop-btn:disabled {
        cursor: wait;
        opacity: 0.65;
    }

    @@media (max-width: 900px) {
        .category-admin {
            padding: 20px;
        }

        .category-page-header {
            align-items: stretch;
            flex-direction: column;
        }

        .category-add-button {
            justify-content: center;
        }

        .category-summary-grid {
            grid-template-columns: 1fr;
        }

        .category-filters {
            grid-template-columns: 1fr;
        }

        .category-table-card {
            overflow-x: auto;
        }

        .category-table {
            min-width: 780px;
        }
    }
</style>

<div id="app" class="category-admin" v-cloak>
    <header class="category-page-header">
        <h1 class="category-page-title">Categorias</h1>

        <button type="button" class="category-add-button" v-on:click="handler.handleNew">
            <i class="fa fa-plus" aria-hidden="true"></i>
            Adicionar categoria
        </button>
    </header>

    <section class="category-summary-grid" aria-label="Resumo de categorias">
        <div class="category-summary-card">
            <div class="category-summary-card__label">Total de categorias</div>
            <div class="category-summary-card__value">{{ state.summary.total }}</div>
        </div>

        <div class="category-summary-card">
            <div class="category-summary-card__label">Ativas</div>
            <div class="category-summary-card__value category-summary-card__value--green">{{ state.summary.active }}</div>
        </div>

        <div class="category-summary-card">
            <div class="category-summary-card__label">Inativas</div>
            <div class="category-summary-card__value category-summary-card__value--red">{{ state.summary.inactive }}</div>
        </div>
    </section>

    <section class="category-filters" aria-label="Filtros de categorias">
        <input v-model="state.filters.search"
               class="category-filter-control"
               type="search"
               placeholder="Buscar categoria">

        <select v-model="state.filters.status" class="category-filter-control">
            <option value="">Todos os status</option>
            <option value="active">Ativas</option>
            <option value="inactive">Inativas</option>
        </select>
    </section>

    <section class="category-table-card">
        <table class="category-table">
            <thead>
                <tr>
                    <th>
                        <button type="button"
                                class="category-sort-button"
                                v-bind:class="{ 'category-sort-button--active': state.sort.field === 'name' }"
                                v-on:click="handler.handleSort('name')">
                            Categoria
                            <i class="fa category-sort-icon" v-bind:class="methods.getSortIcon('name')" aria-hidden="true"></i>
                        </button>
                    </th>
                    <th>
                        <button type="button"
                                class="category-sort-button"
                                v-bind:class="{ 'category-sort-button--active': state.sort.field === 'description' }"
                                v-on:click="handler.handleSort('description')">
                            Descricao
                            <i class="fa category-sort-icon" v-bind:class="methods.getSortIcon('description')" aria-hidden="true"></i>
                        </button>
                    </th>
                    <th>
                        <button type="button"
                                class="category-sort-button"
                                v-bind:class="{ 'category-sort-button--active': state.sort.field === 'createdAt' }"
                                v-on:click="handler.handleSort('createdAt')">
                            Inserido em
                            <i class="fa category-sort-icon" v-bind:class="methods.getSortIcon('createdAt')" aria-hidden="true"></i>
                        </button>
                    </th>
                    <th>
                        <button type="button"
                                class="category-sort-button"
                                v-bind:class="{ 'category-sort-button--active': state.sort.field === 'status' }"
                                v-on:click="handler.handleSort('status')">
                            Status
                            <i class="fa category-sort-icon" v-bind:class="methods.getSortIcon('status')" aria-hidden="true"></i>
                        </button>
                    </th>
                    <th class="text-right">Acoes</th>
                </tr>
            </thead>
            <tbody>
                <tr v-for="category in filteredCategories" v-bind:key="category.id">
                    <td>
                        <span class="category-table__name">{{ category.name }}</span>
                    </td>
                    <td>{{ category.description || '-' }}</td>
                    <td>
                        <span class="category-table__date">
                            {{ methods.formatInsertedDate(category).date }}
                            <span class="category-table__time">{{ methods.formatInsertedDate(category).time }}</span>
                        </span>
                    </td>
                    <td>
                        <span class="category-status" v-bind:class="methods.getStatusClass(category)">
                            {{ methods.getStatusLabel(category) }}
                        </span>
                    </td>
                    <td class="category-table__actions">
                        <button type="button" class="category-action-button" title="Editar" v-on:click="handler.handleEdit(category)">
                            <i class="fas fa-pencil-alt" aria-hidden="true"></i>
                        </button>
                        <button type="button" class="category-action-button category-action-button--danger" title="Excluir" v-on:click="handler.handleDelete(category)">
                            <i class="fas fa-trash-alt" aria-hidden="true"></i>
                        </button>
                    </td>
                </tr>
                <tr v-if="filteredCategories.length === 0">
                    <td colspan="5" class="category-empty-row">Nenhuma categoria encontrada.</td>
                </tr>
            </tbody>
        </table>
    </section>

    <div class="modal fade" ref="mainModalRef" id="MainModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-md">
            <div class="modal-content category-modal">
                <div class="modal-header">
                    <h5 class="modal-title">{{ state.mainTitle }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" v-model="state.id" />

                    <form id="MainForm">
                        <div class="row mb-2">
                            <div class="col-12">
                                <label>Nome da Categoria</label>
                                <input ref="nameRef"
                                       v-model="state.name"
                                       type="text"
                                       class="form-control"
                                       v-bind:disabled="state.deleteMode">
                                <label class="text-danger">{{ state.errors.name }}</label>
                            </div>
                        </div>

                        <div class="row mb-2">
                            <div class="col-12">
                                <label>Descricao</label>
                                <textarea v-model="state.description"
                                          class="form-control"
                                          rows="3"
                                          v-bind:disabled="state.deleteMode"></textarea>
                                <label class="text-danger">{{ state.errors.description }}</label>
                            </div>
                        </div>

                        <div class="row mb-2">
                            <div class="col-12 form-check">
                                <input type="checkbox"
                                       class="form-check-input"
                                       id="IsActive"
                                       v-model="state.isActive"
                                       v-bind:disabled="state.deleteMode">
                                <label class="form-check-label" for="IsActive">Ativa</label>
                            </div>
                        </div>
                    </form>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="category-drop-btn category-drop-btn--ghost"
                            data-bs-dismiss="modal">
                        Fechar
                    </button>

                    <button type="button"
                            id="MainSaveButton"
                            class="category-drop-btn"
                            v-bind:class="state.deleteMode ? 'category-drop-btn--danger' : 'category-drop-btn--primary'"
                            v-on:click="handler.handleSubmit"
                            v-bind:disabled="state.isSubmitting">

                        <span class="spinner-border spinner-border-sm me-2"
                              v-if="state.isSubmitting"></span>

                        <span v-if="!state.isSubmitting">
                            {{ state.deleteMode ? 'Excluir' : 'Salvar' }}
                        </span>

                        <span v-else>
                            {{ state.deleteMode ? 'Excluindo...' : 'Salvando...' }}
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/FrontEnd/Pages/Categories/Category.cshtml.js?v=20260516"></script>
}
