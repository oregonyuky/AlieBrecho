{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=app.db"
  },
  "DatabaseProvider": "Sqlite", //Options: SqlServer, PostgreSQL, MySql, Sqlite
  "MelhorEnvio": {
    "BaseUrl": "%MELHOR_ENVIO_BASE_URL%",
    "Token": "%MELHOR_ENVIO_TOKEN%"
  },
  "InfinitePay": {
    "Handle": "%INFINITE_PAY_HANDLE%",
    "BaseUrl": "https://checkout.infinitepay.io",
    "RedirectUrl": "%INFINITE_PAY_REDIRECT_URL%",
    "WebhookUrl": "%INFINITE_PAY_WEBHOOK_URL%"
  },
  "MercadoPago": {
    "AccessToken": "%MERCADO_PAGO_ACCESS_TOKEN%",
    "BaseUrl": "https://api.mercadopago.com",
    "ExpirationMinutes": 30
  },
  "FileImageManager": {
    "PathFolder": "wwwroot/app_data/images",
    "MaxFileSizeInMB": 5,
    "SupabaseUrl": "",
    "SupabaseServiceRoleKey": "",
    "SupabaseStorageBucket": "products"
  },
  "FileDocumentManager": {
    "PathFolder": "wwwroot/app_data/docs",
    "MaxFileSizeInMB": 25
  },
  "AspNetIdentity": {
    "Password": {
      "RequireDigit": false,
      "RequireLowercase": false,
      "RequireUppercase": false,
      "RequireNonAlphanumeric": false,
      "RequiredLength": 6
    },
    "Lockout": {
      "DefaultLockoutTimeSpanInMinutes": 30,
      "MaxFailedAccessAttempts": 5,
      "AllowedForNewUsers": true
    },
    "User": {
      "RequireUniqueEmail": true
    },
    "SignIn": {
      "RequireConfirmedEmail": false //confirmation will sent through email, make sure SMTP Config is OK.
    },
    "DefaultAdmin": {
      "Email": "%DEFAULT_ADMIN_EMAIL%",
      "Password": "%DEFAULT_ADMIN_SENHA%"
    }
  },
  "Jwt": {
    "Key": "%JWT_KEY%",
    "Issuer": "YourIssuer",
    "Audience": "YourAudience",
    "ExpireInMinute": 30,
    "ClockSkewInMinute": 0
  },
  "Google": {
    "Admin": {
      "ClientId": "%ADMIN_CLIENT_ID%"
    },
    "Customer": {
      "ClientId": "%CUSTOMER_CLIENT_ID%"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5000",
      "https://localhost:5001",
      "http://localhost:5002",
      "https://localhost:5003",
      "http://localhost:5016",
      "https://localhost:7016"
    ]
  },
  "SmtpSettings": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "UserName": "%SMTP_SETTINGS_USER_NAME%",
    "Password": "%SENHA_APP_GOOGLE%", //if use smtp.gmail.com, use the GMAIL app password, not your email password. https://support.google.com/mail/answer/185833?hl=en
    "FromAddress": "%SMTP_SETTINS_USER_ADDRESS%",
    "FromName": "ALIEBRECHO"
  },
  "IsDemoVersion": false,
  "AllowedHosts": "*"
}
